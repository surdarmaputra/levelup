{
  "permissions": {
    "allow": [
      "Bash(git status)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git fetch*)",
      "Bash(git branch*)",
      "Bash(ls*)",
      "Bash(cat*)",
      "Bash(find . -name*)",
      "Bash(grep -rn*)",
      "Bash(npm run build*)",
      "Bash(npm run check*)",
      "Bash(npm run verify*)",
      "Bash(node scripts/check-links.mjs*)",
      "Bash(bash scripts/bootstrap.sh*)",
      "Bash(bash scripts/verify-project.sh*)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "bash scripts/bootstrap.sh"
          }
        ]
      }
    ]
  }
}
