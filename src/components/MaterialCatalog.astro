---
import { materials } from '../catalog';

/** Join the configured base path with a content slug, e.g. `/levelup/` + `java-spring-boot`. */
function href(slug: string) {
  const base = import.meta.env.BASE_URL.replace(/\/$/, '');
  return `${base}/${slug}/`;
}

const statusLabel: Record<string, string> = {
  available: 'Available',
  draft: 'In progress',
  planned: 'Planned',
};
---

<ul class="material-catalog">
  {
    materials.map((material) => (
      <li class="material-card" data-status={material.status}>
        <div class="material-card__meta">
          <span class="material-card__status">{statusLabel[material.status]}</span>
          <span>{material.level}</span>
          <span>{material.size}</span>
        </div>
        <h3 class="material-card__title">
          {material.status === 'planned' ? (
            material.title
          ) : (
            <a href={href(material.entry)}>{material.title}</a>
          )}
        </h3>
        <p class="material-card__description">{material.description}</p>
        <ul class="material-card__tags">
          {material.tags.map((tag) => (
            <li>{tag}</li>
          ))}
        </ul>
        {material.status !== 'planned' && (
          <a class="material-card__cta" href={href(material.entry)}>
            Start learning
            <span aria-hidden="true">→</span>
          </a>
        )}
      </li>
    ))
  }
</ul>

<style>
  .material-catalog {
    list-style: none;
    padding: 0;
    margin-top: 1.5rem;
    display: grid;
    gap: 1.25rem;
    grid-template-columns: repeat(auto-fill, minmax(18rem, 1fr));
  }

  .material-card {
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    padding: 1.25rem;
    border: 1px solid var(--sl-color-gray-5);
    border-radius: 0.5rem;
    background: var(--sl-color-black);
  }

  .material-card[data-status='planned'] {
    opacity: 0.7;
  }

  .material-card__meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    font-size: var(--sl-text-xs);
    color: var(--sl-color-gray-3);
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }

  .material-card__status {
    color: var(--sl-color-accent-high);
    font-weight: 600;
  }

  .material-card__title {
    margin: 0;
    font-size: var(--sl-text-h4);
    line-height: 1.3;
  }

  .material-card__title a {
    text-decoration: none;
  }

  .material-card__description {
    margin: 0;
    color: var(--sl-color-gray-2);
    font-size: var(--sl-text-sm);
  }

  .material-card__tags {
    list-style: none;
    padding: 0;
    margin: 0.25rem 0 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
  }

  .material-card__tags li {
    font-size: var(--sl-text-xs);
    padding: 0.15rem 0.5rem;
    border-radius: 999px;
    border: 1px solid var(--sl-color-gray-5);
    color: var(--sl-color-gray-2);
  }

  .material-card__cta {
    margin-top: auto;
    padding-top: 0.5rem;
    font-size: var(--sl-text-sm);
    font-weight: 600;
    text-decoration: none;
  }

  .material-card__cta span {
    display: inline-block;
    margin-left: 0.3rem;
    transition: transform 0.15s ease;
  }

  .material-card__cta:hover span {
    transform: translateX(0.2rem);
  }
</style>
