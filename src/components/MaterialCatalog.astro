---
import { materials } from '../catalog';

/** Join the configured base path with a content slug, e.g. `/levelup/` + `laravel-booking-saas`. */
function href(slug: string) {
  const base = import.meta.env.BASE_URL.replace(/\/$/, '');
  return `${base}/${slug}/`;
}

---

<ul class="material-catalog">
  {
    materials.map((material, index) => (
      <li class="material-card lu-glass" data-status={material.status} style={`--lu-i:${index}`}>
        <h3 class="material-card__title">
          {material.status === 'planned' ? (
            material.title
          ) : (
            <a href={href(material.entry)}>{material.title}</a>
          )}
        </h3>
        <p class="material-card__description">{material.description}</p>
        <div class="material-card__meta">
          <span>{material.level}</span>
          <span aria-hidden="true">·</span>
          <span>{material.size}</span>
        </div>
        <ul class="material-card__tags">
          {material.tags.map((tag) => (
            <li>{tag}</li>
          ))}
        </ul>
        {material.status !== 'planned' && (
          <a class="material-card__cta" href={href(material.entry)}>
            Start learning
            <span aria-hidden="true">→</span>
          </a>
        )}
      </li>
    ))
  }
</ul>

<style>
  .material-catalog {
    list-style: none;
    padding: 0;
    margin-top: 2rem;
    display: grid;
    gap: 1.25rem;
    grid-template-columns: 1fr;
  }

  @media (min-width: 34rem) {
    .material-catalog {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (min-width: 50rem) {
    .material-catalog {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  /* Fill, hairline and blur come from the shared `.lu-glass` recipe. */
  .material-card {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    padding: 1.25rem;
    border-radius: var(--lu-radius-card);
  }

  @media (prefers-reduced-motion: no-preference) {
    .material-card {
      opacity: 0;
      transform: translateY(10px);
      animation: card-in 0.5s cubic-bezier(0.22, 1, 0.36, 1) forwards;
      animation-delay: calc(var(--lu-i, 0) * 70ms);
      transition:
        transform 0.2s cubic-bezier(0.22, 1, 0.36, 1),
        box-shadow 0.25s ease,
        border-color 0.2s ease;
    }

    .material-card:not([data-status='planned']):hover {
      transform: translateY(-3px);
    }
  }

  @keyframes card-in {
    to {
      opacity: 1;
      transform: none;
    }
  }

  .material-card:not([data-status='planned']):hover {
    border-color: transparent;
    /* The glow that makes the edge below read as neon rather than a hairline. */
    box-shadow:
      0 0 0 1px color-mix(in srgb, var(--lu-lime) 12%, transparent),
      0 0 26px -6px color-mix(in srgb, var(--lu-lime) 34%, transparent),
      0 0 18px -8px color-mix(in srgb, var(--lu-teal) 34%, transparent);
  }

  /* Neon edge — a conic gradient the width of the card's border, revealed on
     hover and rotated by animating `--lu-neon-angle`. The mask keeps only the
     one-pixel ring, so the card's own fill shows through the middle.

     Where `@property` is unsupported the angle stays unregistered, the gradient
     is dropped, and the card falls back to its hairline border. */
  @property --lu-neon-angle {
    syntax: '<angle>';
    inherits: false;
    initial-value: 0deg;
  }

  .material-card:not([data-status='planned'])::before {
    content: '';
    position: absolute;
    inset: -1px;
    z-index: 2;
    padding: 1px;
    border-radius: calc(var(--lu-radius-card) + 1px);
    pointer-events: none;
    opacity: 0;
    transition: opacity 0.25s ease;
    background: conic-gradient(
      from var(--lu-neon-angle),
      transparent 0turn,
      var(--lu-lime) 0.13turn,
      var(--lu-teal) 0.25turn,
      transparent 0.38turn,
      transparent 0.5turn,
      var(--lu-lime) 0.63turn,
      var(--lu-teal) 0.75turn,
      transparent 0.88turn
    );
    -webkit-mask:
      linear-gradient(#000 0 0) content-box,
      linear-gradient(#000 0 0);
    mask:
      linear-gradient(#000 0 0) content-box,
      linear-gradient(#000 0 0);
    -webkit-mask-composite: xor;
    mask-composite: exclude;
  }

  .material-card:not([data-status='planned']):hover::before {
    opacity: 1;
  }

  @media (prefers-reduced-motion: no-preference) {
    .material-card:not([data-status='planned']):hover::before {
      animation: lu-neon-spin 3s linear infinite;
    }
  }

  @keyframes lu-neon-spin {
    to {
      --lu-neon-angle: 360deg;
    }
  }

  .material-card[data-status='planned'] {
    opacity: 0.6;
  }

  .material-card__meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-top: 0.15rem;
    font-size: var(--sl-text-2xs);
    color: var(--sl-color-gray-3);
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }

  .material-card__title {
    margin: 0;
    font-size: var(--sl-text-lg);
    font-weight: 510;
    letter-spacing: -0.012em;
    line-height: 1.33;
  }

  .material-card__title a {
    color: var(--sl-color-white);
    text-decoration: none;
  }

  .material-card__description {
    margin: 0;
    color: var(--sl-color-gray-3);
    font-size: var(--sl-text-xs);
    line-height: 1.6;
  }

  .material-card__tags {
    list-style: none;
    padding: 0;
    margin: 0.5rem 0 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
  }

  .material-card__tags li {
    font-size: var(--sl-text-2xs);
    padding: 0.15rem 0.6rem;
    border-radius: var(--lu-radius-pill);
    background: var(--lu-surface-hover);
    color: var(--sl-color-gray-2);
  }

  .material-card__cta {
    margin-top: auto;
    padding-top: 1rem;
    color: var(--sl-color-white);
    font-size: var(--sl-text-xs);
    font-weight: 510;
    text-decoration: none;
  }

  .material-card__cta span {
    display: inline-block;
    margin-left: 0.3rem;
    transition: transform 0.15s ease;
  }

  .material-card__cta:hover span {
    transform: translateX(0.2rem);
  }
</style>
