---
interface Step {
  n: number | string;
  title: string;
  mode: 'learn' | 'build';
}

interface Band {
  label: string;
  href: string;
  steps: Step[];
}

interface Props {
  bands: Band[];
  caption?: string;
}

const { bands, caption = 'Skim the overview first. Work the steps in order.' } = Astro.props;
---

<figure class="lu-figure map">
  <div class="lu-figure__frame">
    <ul class="bands">
      {
        bands.map((band) => (
          <li class="band">
            <a class="band__label" href={band.href}>
              {band.label}
              <span class="band__range">
                {band.steps.length > 1
                  ? `${band.steps[0].n}–${band.steps[band.steps.length - 1].n}`
                  : band.steps[0].n}
              </span>
            </a>
            <ul class="steps">
              {band.steps.map((step) => (
                <li class={`step step--${step.mode}`}>
                  <span class="step__n">{step.n}</span>
                  <span class="step__title">{step.title}</span>
                </li>
              ))}
            </ul>
          </li>
        ))
      }
    </ul>

    <p class="legend">
      <span class="key key--learn">LEARN</span> the agent tutors, you decide
      <span class="key key--build">BUILD</span> the agent may generate
    </p>
  </div>
  <figcaption class="lu-figure__caption">{caption}</figcaption>
</figure>

<style>
  .bands {
    display: flex;
    flex-direction: column;
    gap: 0.875rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .band {
    display: grid;
    grid-template-columns: 10.5rem 1fr;
    gap: 0.75rem;
    align-items: start;
  }

  .band__label {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.5rem;
    padding: 0.375rem 0.5rem 0.375rem 0;
    border-right: 1px solid var(--sl-color-hairline);
    font-size: 0.875rem;
    font-weight: 590;
    color: var(--sl-color-white);
    text-decoration: none;
  }

  .band__label:hover {
    color: var(--lu-marker);
  }

  .band__range {
    white-space: nowrap;
    font-family: var(--sl-font-mono);
    font-size: 0.6875rem;
    color: var(--sl-color-gray-4);
  }

  .steps {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 0.375rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .step {
    display: flex;
    gap: 0.4375rem;
    align-items: baseline;
    padding: 0.4375rem 0.5rem;
    border: 1px solid var(--sl-color-hairline);
    border-radius: var(--lu-radius-badge);
    background: var(--lu-surface-2);
    font-size: 0.75rem;
    line-height: 1.3;
    color: var(--sl-color-gray-3);
  }

  .step--build {
    border-color: var(--sl-color-gray-5);
    border-left: 2px solid var(--lu-marker);
    color: var(--sl-color-gray-2);
  }

  .step--build .step__n {
    color: var(--lu-marker);
  }

  .step__n {
    flex-shrink: 0;
    font-family: var(--sl-font-mono);
    font-size: 0.6875rem;
    color: var(--sl-color-gray-4);
  }

  .legend {
    display: flex;
    flex-wrap: wrap;
    gap: 0.375rem 0.75rem;
    align-items: baseline;
    margin: 1.125rem 0 0;
    padding-top: 0.875rem;
    border-top: 1px solid var(--sl-color-hairline);
    font-size: 0.75rem;
    color: var(--sl-color-gray-3);
  }

  .key {
    padding: 0.125rem 0.375rem;
    border: 1px solid var(--sl-color-hairline);
    border-radius: var(--lu-radius-badge);
    font-family: var(--sl-font-mono);
    font-size: 0.6875rem;
    letter-spacing: 0.04em;
  }

  .key--learn {
    color: var(--sl-color-gray-3);
  }

  .key--build {
    border-color: var(--sl-color-gray-5);
    border-left: 2px solid var(--lu-marker);
    color: var(--lu-marker);
  }

  @media (max-width: 60rem) {
    .steps {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 44rem) {
    .steps {
      grid-template-columns: 1fr;
    }

    .band {
      grid-template-columns: 1fr;
      gap: 0.375rem;
    }

    .band__label {
      justify-content: flex-start;
      padding: 0;
      border-right: 0;
    }
  }
</style>
