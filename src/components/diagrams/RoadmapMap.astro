---
/**
 * RoadmapMap — all eighteen steps on one page, banded by section and marked
 * LEARN or BUILD, so a reader can see the shape of the path before starting it.
 */

const bands = [
  {
    label: 'Strategy',
    href: './roadmap/strategy/',
    steps: [
      { n: 0, title: 'What a failure costs', mode: 'learn' },
      { n: 1, title: 'What to test, and where', mode: 'learn' },
      { n: 2, title: 'Environments and data', mode: 'learn' },
      { n: 3, title: 'What "ready" means', mode: 'learn' },
    ],
  },
  {
    label: 'Foundations',
    href: './roadmap/foundations/',
    steps: [
      { n: 4, title: 'Tooling and the products', mode: 'build' },
      { n: 5, title: 'The first journey', mode: 'build' },
      { n: 6, title: 'A suite that survives', mode: 'learn' },
      { n: 7, title: 'The API level', mode: 'build' },
    ],
  },
  {
    label: 'Depth',
    href: './roadmap/depth/',
    steps: [
      { n: 8, title: 'A service with no screen', mode: 'learn' },
      { n: 9, title: 'Contracts and stubs', mode: 'learn' },
      { n: 10, title: 'Flake is a defect', mode: 'learn' },
      { n: 11, title: 'Accessibility and evidence', mode: 'build' },
      { n: 12, title: 'Exploratory testing', mode: 'learn' },
    ],
  },
  {
    label: 'Non-functional',
    href: './roadmap/nonfunctional/',
    steps: [
      { n: 13, title: 'Performance', mode: 'learn' },
      { n: 14, title: 'Permissions, proved', mode: 'build' },
    ],
  },
  {
    label: 'Release',
    href: './roadmap/release/',
    steps: [
      { n: 15, title: 'The pipeline', mode: 'build' },
      { n: 16, title: 'The gate', mode: 'learn' },
    ],
  },
  {
    label: 'Operations',
    href: './roadmap/operations/',
    steps: [{ n: 17, title: 'After the release', mode: 'build' }],
  },
];
---

<figure class="lu-figure map">
  <div class="lu-figure__frame">
    <ul class="bands">
      {
        bands.map((band) => (
          <li class="band">
            <a class="band__label" href={band.href}>
              {band.label}
              <span class="band__range">
                {band.steps.length > 1
                  ? `${band.steps[0].n}–${band.steps[band.steps.length - 1].n}`
                  : band.steps[0].n}
              </span>
            </a>
            <ul class="steps">
              {band.steps.map((step) => (
                <li class={`step step--${step.mode}`}>
                  <span class="step__n">{step.n}</span>
                  <span class="step__title">{step.title}</span>
                </li>
              ))}
            </ul>
          </li>
        ))
      }
    </ul>

    <p class="legend">
      <span class="key key--learn">LEARN</span> the agent tutors, you decide
      <span class="key key--build">BUILD</span> the agent may generate
    </p>
  </div>
  <figcaption class="lu-figure__caption">
    Four steps before any code, and the theory does not stop there — the two
    hardest design decisions, at steps 6 and 10, are <code>LEARN</code> as well.
  </figcaption>
</figure>

<style>
  .bands {
    display: flex;
    flex-direction: column;
    gap: 0.875rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .band {
    display: grid;
    grid-template-columns: 10.5rem 1fr;
    gap: 0.75rem;
    align-items: start;
  }

  .band__label {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.5rem;
    padding: 0.375rem 0.5rem 0.375rem 0;
    border-right: 1px solid var(--sl-color-hairline);
    font-size: 0.875rem;
    font-weight: 590;
    color: var(--sl-color-white);
    text-decoration: none;
  }

  .band__label:hover {
    color: var(--lu-marker);
  }

  .band__range {
    white-space: nowrap;
    font-family: var(--sl-font-mono);
    font-size: 0.6875rem;
    color: var(--sl-color-gray-4);
  }

  .steps {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 0.375rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .step {
    display: flex;
    gap: 0.4375rem;
    align-items: baseline;
    padding: 0.4375rem 0.5rem;
    border: 1px solid var(--sl-color-hairline);
    border-radius: var(--lu-radius-badge);
    background: var(--lu-surface-2);
    font-size: 0.75rem;
    line-height: 1.3;
    color: var(--sl-color-gray-3);
  }

  .step--build {
    border-color: var(--sl-color-gray-5);
    border-left: 2px solid var(--lu-marker);
    color: var(--sl-color-gray-2);
  }

  .step--build .step__n {
    color: var(--lu-marker);
  }

  .step__n {
    flex-shrink: 0;
    font-family: var(--sl-font-mono);
    font-size: 0.6875rem;
    color: var(--sl-color-gray-4);
  }

  .legend {
    display: flex;
    flex-wrap: wrap;
    gap: 0.375rem 0.75rem;
    align-items: baseline;
    margin: 1.125rem 0 0;
    padding-top: 0.875rem;
    border-top: 1px solid var(--sl-color-hairline);
    font-size: 0.75rem;
    color: var(--sl-color-gray-3);
  }

  .key {
    padding: 0.125rem 0.375rem;
    border: 1px solid var(--sl-color-hairline);
    border-radius: var(--lu-radius-badge);
    font-family: var(--sl-font-mono);
    font-size: 0.6875rem;
    letter-spacing: 0.04em;
  }

  .key--learn {
    color: var(--sl-color-gray-3);
  }

  .key--build {
    border-color: var(--sl-color-gray-5);
    border-left: 2px solid var(--lu-marker);
    color: var(--lu-marker);
  }

  @media (max-width: 60rem) {
    .steps {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 44rem) {
    .steps {
      grid-template-columns: 1fr;
    }

    .band {
      grid-template-columns: 1fr;
      gap: 0.375rem;
    }

    .band__label {
      justify-content: flex-start;
      padding: 0;
      border-right: 0;
    }
  }
</style>
